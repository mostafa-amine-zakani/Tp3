                "    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Types = Table.TransformColumnTypes(EnTetes, {{\"IATA_CODE\", type text}, {\"Airline\", type text}, {\"Headquarters_Location\", type text}, {\"Country\", type text}})",
