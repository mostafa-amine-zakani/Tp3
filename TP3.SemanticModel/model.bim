            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Variation_Prix",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "DIVIDE ( flight_prices[price], CALCULATE ( AVERAGE ( flight_prices[price] ), ALL ( flight_prices ) ) ) - 1",
            "formatString": "0.0%",
            "lineageTag": "beb898f8-0454-5165-ae51-e53b3d4a7c03",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "flight_prices",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(if Text.StartsWith(DossierTP3, \"http\") then Web.Contents(DossierTP3 & \"/data/clean/flight_prices.csv\") else File.Contents(DossierTP3 & \"\\data\\clean\\flight_prices.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Types = Table.TransformColumnTypes(EnTetes, {",
                "        {\"flight_id\", Int64.Type}, {\"OP_CARRIER\", type text}, {\"flight\", type text},",
                "        {\"source_city\", type text}, {\"Arrival_date\", type date}, {\"departure_time\", type text},",
                "        {\"stops\", Int64.Type}, {\"arrival_time\", type text}, {\"destination_city\", type text},",
                "        {\"class\", type text}, {\"duration\", type number}, {\"price\", type number}, {\"Weather_ID\", Int64.Type},",
                "        {\"Prix_Categorie\", type text}, {\"Duree_Minutes\", type number}, {\"Trajet\", type text},",
                "        {\"Ordre_Depart\", Int64.Type}, {\"Seuil_Anomalie\", type number}, {\"Est_Anomalie\", type text}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Prix Moyen",
            "expression": "AVERAGE ( flight_prices[price] )",
            "lineageTag": "52aff7f7-88ea-5b3d-acdb-e09d3cd23118",
            "formatString": "#,0"
          },
          {
            "name": "Durée Moyenne",
            "expression": "AVERAGE ( flight_prices[duration] )",
            "lineageTag": "90ffdf03-7527-535e-b1d1-2721173be4da",
            "formatString": "0.00"
          },
          {
            "name": "Prix Moyen par Classe",
            "expression": "CALCULATE ( [Prix Moyen], ALLEXCEPT ( flight_prices, flight_prices[class] ) )",
            "lineageTag": "b636df15-f94e-51c4-8faa-e7090ac2e1d8",
            "formatString": "#,0"
          },
          {
            "name": "Écart Prix",
            "expression": "[Prix Moyen] - CALCULATE ( [Prix Moyen], ALL ( flight_prices ) )",
            "lineageTag": "2c68086a-f251-5849-90d0-fefa7eec2efa",
            "formatString": "#,0"
          },
          {
            "name": "Taux Vols Directs",
            "expression": "DIVIDE ( COUNTROWS ( FILTER ( flight_prices, flight_prices[stops] = 0 ) ), COUNTROWS ( flight_prices ) )",
            "lineageTag": "9bd7edfe-a729-5db6-adb0-0c3bda9a82de",
            "formatString": "0.0%"
          },
          {
            "name": "Nombre de Vols",
            "expression": "COUNTROWS ( flight_prices )",
            "lineageTag": "e40364ec-5054-556a-b8d8-7f553b65b348",
            "formatString": "#,0"
          },
          {
            "name": "Escales Moyennes",
            "expression": "AVERAGE ( flight_prices[stops] )",
            "lineageTag": "05172862-4763-584a-a169-2ba86367cd8a",
            "formatString": "0.00"
          },
          {
            "name": "Durée Moyenne (min)",
            "expression": "AVERAGE ( flight_prices[Duree_Minutes] )",
            "lineageTag": "8f35d74b-48f0-5d96-8aa8-717ef32d1372",
            "formatString": "#,0"
          },
          {
            "name": "Nb Anomalies",
            "expression": "CALCULATE ( COUNTROWS ( flight_prices ), flight_prices[Est_Anomalie] = \"Oui\" )",
            "lineageTag": "a76cb64c-9239-5ded-8e81-f870f1843061",
            "formatString": "#,0"
          },
          {
            "name": "Couleur Prix",
            "expression": "SWITCH ( TRUE (), [Prix Moyen] < 10000, \"#2E7D32\", [Prix Moyen] < 20000, \"#F9A825\", \"#C62828\" )",
            "lineageTag": "a00731f0-b1c8-5440-b1c3-1b07f7aaf0e4"
          },
          {
            "name": "Prix Moyen Economy",
            "expression": "CALCULATE ( [Prix Moyen], flight_prices[class] = \"Economy\" )",
            "lineageTag": "a0c97fcf-2dd4-5359-8c77-afcca16e7d8c",
            "formatString": "#,0"
          },
          {
            "name": "Durée Moyenne Economy",
            "expression": "CALCULATE ( [Durée Moyenne], flight_prices[class] = \"Economy\" )",
            "lineageTag": "360d9e1a-40eb-556c-8db6-39a57f679f62",
            "formatString": "0.00"
          },
          {
            "name": "Taux Vols Directs Economy",
            "expression": "CALCULATE ( [Taux Vols Directs], flight_prices[class] = \"Economy\" )",
            "lineageTag": "099989a7-e727-519a-a84e-bff6a4ce8ca8",
            "formatString": "0.0%"
          },
          {
            "name": "Nombre de Vols Economy",
            "expression": "CALCULATE ( [Nombre de Vols], flight_prices[class] = \"Economy\" )",
            "lineageTag": "b27a1804-bc01-5f8e-9c13-e1ccb020cf6d",
            "formatString": "#,0"
          },
          {
            "name": "Corrélation Heure-Prix",
            "expression": "VAR mx = AVERAGE ( flight_prices[Ordre_Depart] )\nVAR my = AVERAGE ( flight_prices[price] )\nVAR cov = SUMX ( flight_prices, ( flight_prices[Ordre_Depart] - mx ) * ( flight_prices[price] - my ) )\nVAR sx = SQRT ( SUMX ( flight_prices, ( flight_prices[Ordre_Depart] - mx ) ^ 2 ) )\nVAR sy = SQRT ( SUMX ( flight_prices, ( flight_prices[price] - my ) ^ 2 ) )\nRETURN DIVIDE ( cov, sx * sy )",
            "lineageTag": "874f9b79-b355-573d-9fd2-b1a2b6fbda99",
            "formatString": "0.000"
          },
          {
            "name": "Corrélation Durée-Prix",
            "expression": "VAR mx = AVERAGE ( flight_prices[duration] )\nVAR my = AVERAGE ( flight_prices[price] )\nVAR cov = SUMX ( flight_prices, ( flight_prices[duration] - mx ) * ( flight_prices[price] - my ) )\nVAR sx = SQRT ( SUMX ( flight_prices, ( flight_prices[duration] - mx ) ^ 2 ) )\nVAR sy = SQRT ( SUMX ( flight_prices, ( flight_prices[price] - my ) ^ 2 ) )\nRETURN DIVIDE ( cov, sx * sy )",
            "lineageTag": "1e48ebfa-4015-56de-81e8-a5bf056e4d54",
            "formatString": "0.000"
          }
        ]
      },
